{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["auth", "secretHandling", "changes", "residualRisks"],
  "properties": {
    "auth": { "type": "object", "properties": { "provider": { "type": "string" }, "session": { "type": "object" } } },
    "secretHandling": { "type": "object", "properties": { "usesEnv": { "type": "boolean" }, "audited": { "type": "boolean" } }, "required": ["usesEnv"] },
    "changes": { "type": "array", "items": { "type": "string" } },
    "residualRisks": { "type": "array", "items": { "type": "string" } }
  }
}
