{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillranger.local/domains/frontend/ui-evidence-bundle.schema.json",
  "type": "object",
  "required": ["schemaVersion", "id", "variantId", "iteration", "sourceIdentity", "route", "capturedAt", "requiredViewports", "requiredStates", "captures", "adapterCapabilities"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "evidenceLevel": { "enum": ["observation", "verifiable"] },
    "id": { "$ref": "#/$defs/safeId" },
    "variantId": { "$ref": "#/$defs/safeId" },
    "iteration": { "type": "integer", "minimum": 0 },
    "sourceIdentity": { "type": "string", "minLength": 1 },
    "route": { "type": "string", "minLength": 1 },
    "capturedAt": { "type": "string", "format": "date-time" },
    "requiredViewports": { "type": "array", "prefixItems": [{ "const": 390 }, { "const": 768 }, { "const": 1440 }], "items": false, "minItems": 3, "maxItems": 3 },
    "requiredStates": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "captures": { "type": "array", "items": { "$ref": "#/$defs/capture" } },
    "adapterCapabilities": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "safeId": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$" },
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "nonNegativeNumber": { "type": "number", "minimum": 0 },
    "nonNegativeInteger": { "type": "integer", "minimum": 0 },
    "viewport": {
      "type": "object", "required": ["width", "height"],
      "properties": { "width": { "enum": [390, 768, 1440] }, "height": { "type": "integer", "minimum": 1 } },
      "additionalProperties": false
    },
    "stringList": { "type": "array", "items": { "type": "string" } },
    "observation": {
      "type": "object",
      "required": ["schemaVersion", "viewport", "route", "state", "horizontalOverflow", "clippedControls", "unreachableActions", "stickyOverlaps", "consoleErrors", "keyboardTraps", "invisibleFocus", "criticalAxeViolations", "reducedMotionVerified"],
      "properties": {
        "schemaVersion": { "const": "1.0" }, "viewport": { "$ref": "#/$defs/viewport" },
        "route": { "type": "string" }, "state": { "type": "string" }, "horizontalOverflow": { "type": "boolean" },
        "clippedControls": { "$ref": "#/$defs/stringList" }, "unreachableActions": { "$ref": "#/$defs/stringList" },
        "stickyOverlaps": { "$ref": "#/$defs/stringList" }, "consoleErrors": { "$ref": "#/$defs/stringList" },
        "keyboardTraps": { "$ref": "#/$defs/stringList" }, "invisibleFocus": { "$ref": "#/$defs/stringList" },
        "criticalAxeViolations": { "$ref": "#/$defs/stringList" }, "reducedMotionVerified": { "type": "boolean" },
        "screenshotPath": { "type": "string" }
      },
      "additionalProperties": false
    },
    "check": {
      "type": "object",
      "required": ["code", "severity", "gate", "viewport", "state", "locator", "expected", "evidence", "remediation"],
      "properties": {
        "code": { "enum": ["horizontal-overflow", "clipped-content", "element-overlap", "sticky-overlap", "console-error", "unreachable-action", "keyboard-trap", "focus-order", "invisible-focus", "contrast", "critical-axe", "reduced-motion", "state-not-rendered", "state-mismatch", "ui-state-not-rendered", "ui-state-action-missing", "ui-state-change-missing", "ui-state-desynchronized", "inconsistent-spacing", "random-color", "excessive-radii", "excessive-shadows", "generic-card-repetition", "weak-typography-hierarchy", "text-measure", "touch-target"] },
        "severity": { "enum": ["critical", "high", "medium", "low"] }, "gate": { "enum": ["hard", "soft"] },
        "viewport": { "type": "integer" }, "state": { "type": "string" }, "locator": { "type": "string" },
        "measured": { "type": "string" }, "expected": { "type": "string" },
        "evidence": { "$ref": "#/$defs/stringList" }, "remediation": { "type": "string" }
      },
      "additionalProperties": false
    },
    "stateSynchronization": {
      "type": "object",
      "required": ["status", "path", "observations"],
      "properties": {
        "status": { "enum": ["verified", "mismatch", "not-applicable"] },
        "path": { "type": "string", "minLength": 1 },
        "observations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "action": { "type": "string" },
        "changes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["locator", "before", "after"],
            "properties": {
              "locator": { "type": "string", "minLength": 1 },
              "before": { "type": "string" },
              "after": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "reason": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "enum": ["verified", "mismatch"] } }, "required": ["status"] },
          "then": { "properties": { "observations": { "minItems": 2 } } }
        }
      ],
      "additionalProperties": false
    },
    "contrastViolation": {
      "type": "object",
      "required": ["locator", "ratio", "largeText"],
      "properties": {
        "locator": { "type": "string", "minLength": 1 },
        "ratio": { "type": "number", "minimum": 0 },
        "largeText": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "mechanicalSnapshot": {
      "type": "object",
      "required": ["spacingContexts", "colors", "radii", "shadows", "cards", "typography", "textBlocks", "touchTargets"],
      "properties": {
        "spacingContexts": { "type": "array", "items": { "$ref": "#/$defs/spacingContext" } },
        "colors": { "type": "array", "items": { "$ref": "#/$defs/colorSample" } },
        "radii": { "type": "array", "items": { "$ref": "#/$defs/radiusSample" } },
        "shadows": { "type": "array", "items": { "$ref": "#/$defs/shadowSample" } },
        "cards": { "type": "array", "items": { "$ref": "#/$defs/cardSample" } },
        "typography": { "type": "array", "items": { "$ref": "#/$defs/typographySample" } },
        "textBlocks": { "type": "array", "items": { "$ref": "#/$defs/textBlockSample" } },
        "touchTargets": { "type": "array", "items": { "$ref": "#/$defs/touchTargetSample" } }
      },
      "additionalProperties": false
    },
    "spacingContext": {
      "type": "object",
      "required": ["id", "locators", "valuesPx"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "locators": { "$ref": "#/$defs/stringList" },
        "valuesPx": { "type": "array", "items": { "$ref": "#/$defs/nonNegativeNumber" } }
      },
      "additionalProperties": false
    },
    "colorSample": {
      "type": "object",
      "required": ["locator", "value", "occurrences"],
      "properties": {
        "locator": { "$ref": "#/$defs/nonEmptyString" },
        "value": { "$ref": "#/$defs/nonEmptyString" },
        "role": { "$ref": "#/$defs/nonEmptyString" },
        "occurrences": { "$ref": "#/$defs/nonNegativeInteger" }
      },
      "additionalProperties": false
    },
    "radiusSample": {
      "type": "object",
      "required": ["locator", "valuePx", "isPillOrCircle"],
      "properties": {
        "locator": { "$ref": "#/$defs/nonEmptyString" },
        "valuePx": { "$ref": "#/$defs/nonNegativeNumber" },
        "isPillOrCircle": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "shadowSample": {
      "type": "object",
      "required": ["locator", "value", "isNone"],
      "properties": {
        "locator": { "$ref": "#/$defs/nonEmptyString" },
        "value": { "$ref": "#/$defs/nonEmptyString" },
        "isNone": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "cardSample": {
      "type": "object",
      "required": ["locator", "depth", "repeatedCount", "semanticRole"],
      "properties": {
        "locator": { "$ref": "#/$defs/nonEmptyString" },
        "depth": { "$ref": "#/$defs/nonNegativeInteger" },
        "repeatedCount": { "$ref": "#/$defs/nonNegativeInteger" },
        "semanticRole": { "enum": ["generic", "group", "tool", "item"] }
      },
      "additionalProperties": false
    },
    "typographySample": {
      "type": "object",
      "required": ["locator", "role", "fontSizePx", "fontWeight"],
      "properties": {
        "locator": { "$ref": "#/$defs/nonEmptyString" },
        "role": { "enum": ["h1", "h2", "h3", "body", "meta"] },
        "fontSizePx": { "$ref": "#/$defs/nonNegativeNumber" },
        "fontWeight": { "$ref": "#/$defs/nonNegativeNumber" }
      },
      "additionalProperties": false
    },
    "textBlockSample": {
      "type": "object",
      "required": ["locator", "measureCh"],
      "properties": {
        "locator": { "$ref": "#/$defs/nonEmptyString" },
        "measureCh": { "$ref": "#/$defs/nonNegativeNumber" }
      },
      "additionalProperties": false
    },
    "touchTargetSample": {
      "type": "object",
      "required": ["locator", "widthPx", "heightPx", "interactive"],
      "properties": {
        "locator": { "$ref": "#/$defs/nonEmptyString" },
        "widthPx": { "$ref": "#/$defs/nonNegativeNumber" },
        "heightPx": { "$ref": "#/$defs/nonNegativeNumber" },
        "interactive": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "capture": {
      "type": "object", "required": ["viewport", "state", "screenshotPath", "observation", "stateSynchronization", "checks"],
      "properties": {
        "viewport": { "$ref": "#/$defs/viewport" }, "state": { "type": "string" }, "screenshotPath": { "type": "string" },
        "observation": { "$ref": "#/$defs/observation" },
        "stateRendered": { "type": "boolean" },
        "stateSynchronization": { "$ref": "#/$defs/stateSynchronization" },
        "overlaps": { "$ref": "#/$defs/stringList" },
        "focusOrderViolations": { "$ref": "#/$defs/stringList" },
        "contrastViolations": { "type": "array", "items": { "$ref": "#/$defs/contrastViolation" } },
        "mechanicalSnapshot": { "$ref": "#/$defs/mechanicalSnapshot" },
        "checks": { "type": "array", "items": { "$ref": "#/$defs/check" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
